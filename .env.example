# plugin-agentnet settings. Everything resolves through runtime.getSetting
# (character secrets or env). All defaults are safe: the read tier is public
# HTTP/RPC only, and both write gates default OFF.

# ---- write-tier gates (default OFF; leave unset for read-only) ----
# Master gate: no wallet process is ever spawned while this is off.
# AGENTNET_ALLOW_WRITES=1
# Second gate, required on top of writes for buy_skill / publish_skill.
# AGENTNET_ALLOW_SPEND=1

# ---- wallet / signer (write tier only) ----
# Keypair JSON for the spawned server (created if missing). Fund it with only
# what the agent may spend; its balance is the hard ceiling.
# AGENTNET_WALLET_KEYFILE=~/.config/solana/id.json
# "keyfile" (default) or "steward" (remote signer bridge, no local key).
# AGENTNET_SIGNER=keyfile
# Required with AGENTNET_SIGNER=steward; probed live before any spawn.
# AGENTNET_STEWARD_SIGNER_URL=http://127.0.0.1:8177
# Assert the spawned server build ships the AGENTNET_WALLET_REMOTE hook.
# AGENTNET_SIGNER_HOOK=1
# Bearer token for the steward bridge.
# AGENTNET_WALLET_REMOTE_TOKEN=

# ---- server spawn ----
# Full command line, whitespace split. Pin a local build to skip npx.
# AGENTNET_MCP_COMMAND=npx -y @iqlabs-official/agentnet-mcp
# AGENTNET_NETWORK=mainnet

# ---- endpoints (mainnet defaults built in) ----
# AGENTNET_INDEXER_URL=
# AGENTNET_GATEWAY_URL=
# AGENTNET_RPC_URL=

# ---- local state ----
# Where free skills are equipped as SKILL.md files.
# AGENTNET_SKILLS_DIR=
# Extra comma-separated skill dirs forwarded to the server.
# AGENTNET_SKILL_DIRS=
# Server state root and soul-persona character file, forwarded when set.
# AGENTNET_HOME=
# AGENTNET_ELIZA_CHARACTER=
